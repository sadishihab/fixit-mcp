# Copy to .env and adjust as needed. All variables are optional; defaults shown.

FIXIT_HOST=0.0.0.0
FIXIT_PORT=8000
FIXIT_STREAMABLE_HTTP_PATH=/mcp
FIXIT_LOG_LEVEL=INFO
FIXIT_JSON_RESPONSE=true

# Household appliance storage: sqlite (default, local file), memory (in-process,
# resets every run), or agentcore (Amazon Bedrock AgentCore Memory -- needs AWS
# credentials and a memory resource; see README's "AgentCore Memory" section).
FIXIT_REPOSITORY_BACKEND=sqlite
FIXIT_SQLITE_PATH=data/state/appliances.db
# The memory resource's id (not its ARN), e.g. FixItHouseholds-a1B2c3D4e5.
FIXIT_AGENTCORE_MEMORY_ID=
FIXIT_AGENTCORE_REGION=us-east-1
FIXIT_AGENTCORE_REGISTRY_SESSION_ID=appliance-registry
